POSTGRES_DB=garden_center
POSTGRES_USER=garden_center
POSTGRES_PASSWORD=garden_center
DATABASE_URL=postgresql+psycopg://garden_center:garden_center@db:5432/garden_center
DOCUMENT_STORAGE_PATH=/data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARACTERS=2000000
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
OLLAMA_TIMEOUT_SECONDS=30
SEARCH_TOP_K=5
SEARCH_SIMILARITY_THRESHOLD=0.5
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen3:1.7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=512
